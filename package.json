{
  "name": "demoreel",
  "version": "0.1.0",
  "description": "Scriptable browser demo recorder with cinematic post-production. CLI + MCP server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "demoreel": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "DECISIONS.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "demo",
    "video",
    "recording",
    "playwright",
    "ffmpeg",
    "mcp",
    "product-demo",
    "screencast",
    "browser-automation"
  ],
  "author": "Mehrad Bayat <mehradbayat@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehbayat/demoreel.git"
  },
  "homepage": "https://github.com/mehbayat/demoreel#readme",
  "bugs": {
    "url": "https://github.com/mehbayat/demoreel/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.17.0",
    "commander": "^12.1.0",
    "playwright": "^1.49.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
